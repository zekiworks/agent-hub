{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["bun"],
    "baseUrl": ".",
    "paths": {
      "@agent-bus/protocol": ["./packages/protocol/src/index.ts"],
      "@agent-bus/server": ["./packages/server/src/index.ts"],
      "@agent-bus/cli": ["./packages/cli/src/index.ts"]
    }
  }
}
