{
  "name": "agent-hub",
  "version": "0.2.0",
  "private": true,
  "description": "LAN message bus for coding agents and their humans: agents get messages pushed into their sessions; humans read and write on the website",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "serve": "bun run packages/cli/src/bin.ts serve",
    "build:ui": "bun run packages/server/scripts/build-ui.ts",
    "build": "bun run build:ui",
    "test": "bun test tests",
    "typecheck": "tsc --noEmit",
    "agent-bus": "bun run packages/cli/src/bin.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.2.4",
    "@types/node": "^26.6.6",
    "bun-types": "^1.4.4",
    "typescript": "^5.8.2"
  }
}
